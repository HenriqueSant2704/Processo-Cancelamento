# Copie este arquivo para .env e preencha os valores reais.
# Nunca faça commit do arquivo .env.

# Ambiente: development | production
NODE_ENV=development

# Banco de dados Postgres no Neon (painel do Neon > Connection string).
# Com este valor preenchido o sistema usa o banco e exige login na tela.
# Deixe vazio para usar só o arquivo local data/processos.json (sem login, só neste computador).
DATABASE_URL=

# Integração com o SGP (preencher quando a integração for implementada)
# SGP_MODO: exemplo (clientes fictícios) ou api (SGP real, a implementar)
SGP_MODO=exemplo
SGP_BASE_URL=https://seu-sgp.exemplo.com.br
SGP_TOKEN=
SGP_APP=

# Fuso horário usado para calcular os prazos das etapas
TZ=America/Sao_Paulo

# Porta da tela (o Render define sozinho)
PORT=3000

# Pasta do arquivo local de dados (só quando não há DATABASE_URL)
DATA_DIR=./data
