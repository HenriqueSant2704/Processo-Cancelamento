# Copie este arquivo para .env e preencha os valores reais.
# Nunca faça commit do arquivo .env.

# Ambiente: development | production
NODE_ENV=development

# Banco de dados Postgres no Neon (painel do Neon > Connection string).
# Com este valor preenchido o sistema usa o banco e exige login na tela.
# Deixe vazio para usar só o arquivo local data/processos.json (sem login, só neste computador).
DATABASE_URL=

# Integração com o SGP (rota URA de clientes, a mesma usada no NeticoCam)
# SGP_MODO: exemplo (clientes fictícios) ou api (SGP real)
SGP_MODO=exemplo
SGP_URA_CLIENTES_URL=
SGP_APP=
SGP_TOKEN=
# Status do contrato que contam como suspenso (separados por vírgula)
SGP_STATUS_SUSPENSO=SUSPENSO
# Só estes motivos entram no processo (vazio = todos). Ex.: FINANCEIRO
SGP_MOTIVOS_SUSPENSAO=
# Campo do contrato com a data da suspensão, se o SGP mandar (veja com: npm run cli -- sgp-diagnostico)
SGP_CAMPO_DATA_SUSPENSAO=
# Sem esse campo, a data do bloqueio é estimada: vencimento da fatura em aberto mais antiga + N dias
SGP_DIAS_BLOQUEIO_APOS_VENCIMENTO=15
# Sincronização automática uma vez por dia a partir desta hora (sim/nao)
SGP_SINCRONIZACAO_AUTOMATICA=sim
SGP_HORA_SINCRONIZACAO=7

# Botão "Criar no SGP" (GRAVA no SGP). Deixe nao até testar com o Miguel.
SGP_CRIAR_OCORRENCIA=nao
# Username do SGP que aparece como quem abriu a ocorrência (opcional)
SGP_USUARIO_OCORRENCIA=
# Código do método da ocorrência (opcional; ex.: 5 = WhatsApp, 1 = Telefone)
SGP_METODO_OCORRENCIA=
# Abrir também ordem de serviço junto com a ocorrência (sim/nao)
SGP_ABRIR_OS=nao
# Responsável da ocorrência criada pelo sistema, citado no comentário (username do SGP; ex.: jessica_rasteiro)
SGP_RESPONSAVEL_OCORRENCIA=
# Comentário automático na ocorrência a cada ação na tela (GRAVA no SGP; sim/nao)
SGP_COMENTAR_OCORRENCIA=nao

# Fuso horário usado para calcular os prazos das etapas
TZ=America/Sao_Paulo

# Porta da tela (o Render define sozinho)
PORT=3000

# Pasta do arquivo local de dados (só quando não há DATABASE_URL)
DATA_DIR=./data
